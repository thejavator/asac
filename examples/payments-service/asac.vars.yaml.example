# Layer 2: resolves every var.* declared in asac.yaml.
# Copy to asac.vars.yaml (git-ignored), one file per environment.
state_backend: s3://asac-state/payments

gitlab_url: https://gitlab.example.com
gitlab_token: ${vault.gitlab/deploy-token}   # resolved at run time, never stored
jira_url: https://jira.example.com
jira_token: ${vault.jira/api-key}
llm_api_key: ${vault.llm/api-key}
llm_model: claude-opus-5-5

# Concrete harness choices (per team / per developer)
ba_harness: copilot
dev_harness: claude-code
qa_harness: claude-code

# Data residency (v0.4)
data_residency: eu
