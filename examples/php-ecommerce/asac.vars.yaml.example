# Couche 2. Copiez en `asac.vars.yaml` (ignoré par git). Les secrets sont des références ${vault.…}.

tool: claude-code
dev_tool: claude-code

llm_api_key: ${vault.llm/api-key}
# La clé de TEST du prestataire. Aucune clé de production n'existe dans ce dépôt ni dans cet environnement.
payment_key: ${vault.payments/test-key}
# php_version et perf_budget_ms ont une valeur par défaut dans asac.yaml.

autorun: false
sandbox: true
sandbox_domains: "api.example-gateway.test"
retries: 1
runner_kind: docker
runner_image: asac-agent:0.1.0
runner_network: asac-egress
runner_env: ANTHROPIC_API_KEY,ANTHROPIC_BASE_URL
state_backend: sqlite
data_residency: eu
notify_targets:
  - ${vault.notify/teams-ecommerce}
